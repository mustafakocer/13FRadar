{
  "name": "fundocap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fundocap — SEC 13F filings intelligence platform",
  "scripts": {
    "dev": "node server.js",
    "check-env": "node scripts/check-env.mjs",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client && node scripts/build-llms.mjs && node scripts/check-jsonld.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "activity": "node scripts/build-guru-activity.mjs",
    "llms": "node scripts/build-llms.mjs",
    "teaser": "node scripts/build-teaser.mjs",
    "report": "node scripts/build-report.mjs",
    "related": "node scripts/build-related.mjs",
    "filings": "node scripts/build-filings.mjs",
    "alerts": "node scripts/send-alerts.mjs",
    "backfill": "node scripts/backfill-13f.mjs",
    "rebuild": "node scripts/rebuild-derived.mjs",
    "geo-monitor": "node --experimental-strip-types scripts/geo-monitor.ts",
    "test": "node --test tests/*.test.mjs",
    "test:db": "bash scripts/db-test.sh",
    "test:full": "npm run build && node --test tests/*.test.mjs",
    "slugs": "node scripts/build-slugs.mjs",
    "fixtures": "node tests/fixtures/make-fixtures.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "axios": "^1.7.9",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "express": "^4.21.2",
    "openai": "^7.15.0",
    "playwright-core": "^1.47.0"
  },
  "engines": {
    "node": ">=20"
  }
}
