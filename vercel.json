{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "node scripts/check-env.mjs && npm run build --prefix client && node scripts/build-llms.mjs && node scripts/check-jsonld.mjs",
  "outputDirectory": "client/dist",
  "functions": {
    "api/ssr.js": { "includeFiles": "client/dist/**", "maxDuration": 30 },
    "api/index.js": { "includeFiles": "{api/_data/reports/**,reports/**,api/_assets/**}", "maxDuration": 30 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "13-f-radar-omega.vercel.app" }],
      "destination": "https://www.fundocap.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fundocap.co" }],
      "destination": "https://www.fundocap.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/sitemap.xml", "destination": "/api?__path=sitemap&type=index" },
    { "source": "/sitemap-:type.xml", "destination": "/api?__path=sitemap&type=:type" },
    { "source": "/robots.txt", "destination": "/api?__path=sitemap&type=robots" },
    { "source": "/:path*", "destination": "/api/ssr?__path=:path*" }
  ]
}
