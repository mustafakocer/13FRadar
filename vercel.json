{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": false,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "node scripts/check-env.mjs && node scripts/sanitize-returns.mjs && node scripts/build-insiders-served.mjs && npm run build --prefix client && node scripts/build-llms.mjs && node scripts/check-jsonld.mjs",
  "outputDirectory": "client/dist",
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "functions": {
    "api/ssr.js": { "includeFiles": "{client/dist/**,api/_data/insiders-served.json,api/_data/insiders-preview.json}", "maxDuration": 30 },
    "api/index.js": { "includeFiles": "{api/_data/reports/**,api/_data/prices/**,api/_data/insiders-raw*.json,api/_data/insiders-served.json,api/_data/insiders-preview.json,api/_data/splits*.json,api/_data/fpi.json,config/adr-overrides.json,reports/**,api/_assets/**}", "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.clarity.ms https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "13-f-radar-omega.vercel.app" }],
      "destination": "https://www.fundocap.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fundocap.co" }],
      "destination": "https://www.fundocap.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/sitemap.xml", "destination": "/api?__path=sitemap&type=index" },
    { "source": "/sitemap-:type.xml", "destination": "/api?__path=sitemap&type=:type" },
    { "source": "/robots.txt", "destination": "/api?__path=sitemap&type=robots" },
    { "source": "/:path*", "destination": "/api/ssr?__path=:path*" }
  ]
}
