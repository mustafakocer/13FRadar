{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "node scripts/check-env.mjs && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/ssr.js": { "includeFiles": "client/dist/**", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" },
    { "source": "/:path*", "destination": "/api/ssr?__path=:path*" }
  ]
}
